# Backend (MiVuelticaApp/mi-vueltica-api). Leave EXPO_PUBLIC_API_URL empty to run on the in-app MockApi demo data.
# The /api/v1 prefix is added by the app. Use your LAN IP (not localhost) when testing on a device.
EXPO_PUBLIC_API_URL=

# Google sign-in (development build required; it does not run in Expo Go).
# webClientId is what makes Android return an idToken; the API must accept it (issue #35).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Build-time only: reversed iOS client id, e.g. com.googleusercontent.apps.1234-abcd. Enables the config plugin.
GOOGLE_IOS_URL_SCHEME=

# App-store review builds only: shows a "QA" link on the login screen (email + password account for reviewers, POST /auth/qa).
# Leave it empty / unset in production profiles.
EXPO_PUBLIC_IS_ON_REVIEW=

# Push notifications (development build only): the EAS project id from `npx eas-cli@latest init`. Without it the app
# registers no push token (local reminders still work). The APNs key and FCM v1 service account go into EAS credentials.
EAS_PROJECT_ID=

# Mapbox public token (pk.…). Without it the app falls back to the static image map.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Mapbox secret token with DOWNLOADS:READ (sk.…), for native SDK downloads when building.
MAPBOX_DOWNLOADS_TOKEN=
# Map styles per theme. Leave one empty to use Mapbox Streets (light) / Dark.
EXPO_PUBLIC_MAPBOX_STYLE_LIGHT=mapbox://styles/savaldev/cmwn3120x00a201rx0jatghjx
EXPO_PUBLIC_MAPBOX_STYLE_DARK=mapbox://styles/savaldev/cmwn3dxnr00pw01rwe37qbxy6
