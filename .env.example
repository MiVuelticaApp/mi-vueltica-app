# Backend (MiVuelticaApp/mi-vueltica-api). Leave EXPO_PUBLIC_API_URL empty to run on the in-app MockApi demo data.
# The /api/v1 prefix is added by the app. Use your LAN IP (not localhost) when testing on a device.
EXPO_PUBLIC_API_URL=

# Google sign-in (development build required; it does not run in Expo Go).
# webClientId is what makes Android return an idToken; the API must accept it (issue #35).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Build-time only: reversed iOS client id, e.g. com.googleusercontent.apps.1234-abcd. Enables the config plugin.
GOOGLE_IOS_URL_SCHEME=
